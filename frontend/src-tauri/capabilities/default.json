{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Povolené príkazy hlavného okna: len príkazy aplikácie a plugin dialog.",
  "windows": ["main"],
  "permissions": [
    "allow-http-request",
    "allow-live-connect",
    "allow-live-disconnect",
    "allow-config-get",
    "allow-config-set-server-url",
    "allow-config-device-id",
    "allow-app-version",
    "allow-vault-exists",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-rewrap",
    "allow-vault-lock",
    "allow-vault-wipe",
    "allow-vault-put",
    "allow-vault-get",
    "allow-vault-list",
    "allow-vault-remove",
    "allow-vault-info",
    "allow-vault-set-sync-state",
    "allow-update-check",
    "allow-update-install",
    "dialog:default"
  ]
}
