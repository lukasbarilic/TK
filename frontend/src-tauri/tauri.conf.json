{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheraSuite",
  "version": "../package.json",
  "identifier": "sk.therasuite.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TheraSuite",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "wix": {
        "language": "sk-SK",
        "fragmentPaths": ["wix/server-url.wxs"],
        "componentRefs": ["ServerUrlConfig"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "DOPLNIT_VEREJNY_KLUC_AKTUALIZACII_pozri_docs/frontend/AKTUALIZACIE.md",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  }
}
